{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ],
      "passThroughEnv": [
        "VERCEL",
        "AI_EXTRACTION_ENABLED",
        "AI_EXTRACTION_DAILY_LIMIT",
        "OPENAI_API_KEY",
        "OPENAI_EXTRACTION_MODEL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "RESEND_API_KEY",
        "DEMO_NOTIFICATION_FROM",
        "DEMO_ADMIN_EMAIL",
        "DEMO_NOTIFICATION_RETRY_TOKEN"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ],
      "passThroughEnv": [
        "VERCEL",
        "AI_EXTRACTION_ENABLED",
        "AI_EXTRACTION_DAILY_LIMIT",
        "OPENAI_API_KEY",
        "OPENAI_EXTRACTION_MODEL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "RESEND_API_KEY",
        "DEMO_NOTIFICATION_FROM",
        "DEMO_ADMIN_EMAIL",
        "DEMO_NOTIFICATION_RETRY_TOKEN"
      ]
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ],
      "passThroughEnv": [
        "VERCEL",
        "AI_EXTRACTION_ENABLED",
        "AI_EXTRACTION_DAILY_LIMIT",
        "OPENAI_API_KEY",
        "OPENAI_EXTRACTION_MODEL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "RESEND_API_KEY",
        "DEMO_NOTIFICATION_FROM",
        "DEMO_ADMIN_EMAIL",
        "DEMO_NOTIFICATION_RETRY_TOKEN"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test:db": {
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ],
      "passThroughEnv": [
        "VERCEL",
        "CI",
        "PLAYWRIGHT_*"
      ]
    },
    "check:supabase": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ]
    }
  },
  "globalDependencies": [
    "packages/typescript-config/**/*.json"
  ]
}
